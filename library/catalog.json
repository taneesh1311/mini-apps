      "icon": "data:image/png;base64,",
      "preload": "// Runs inside the doorbell's web page. The Reolink web UI forgets its login whenever the page\n// reloads or the session times out, so this remembers the login you type once and fills it\n// in again automatically. The password goes straight to the main process, which stores it\n// encrypted with Windows DPAPI (src/main.js) - only after the doorbell accepted it.\nconst { ipcRenderer } = require('electron');\n\nconst visible = (el) => !!el && !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length);\nconst log = (msg) => ipcRenderer.send('view-log', msg);\n\nfunction loginForm() {\n  const pass = [...document.querySelectorAll('input[type=password]')].find(visible);\n  if (!pass) return null;\n  const root = pass.closest('.login-form, form') || document;\n  const user = [...root.querySelectorAll('input[type=text], input:not([type])')].find(visible);\n  const button = [...root.querySelectorAll('button, input[type=submit], input[type=button]')]\n    .find((b) => visible(b) && /log\\s*in|sign\\s*in/i.test(b.innerText || b.value || ''));\n  // Only the real login screen (not e.g. a \"change password\" page in settings).\n  if (!button || !(pass.closest('.login-form') || /log\\s*in/i.test(button.innerText || button.value))) return null;\n  return { pass, user, button };\n}\n\n// Set a value the way typing would, so the page's framework (Vue) notices it.\nfunction fill(input, value) {\n  const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set;\n  setter.call(input, value);\n  input.dispatchEvent(new Event('input', { bubbles: true }));\n  input.dispatchEvent(new Event('change', { bubbles: true }));\n}\n\n// Remember what you type when you press Login / Enter.\nfunction captureTyped() {\n  const f = loginForm();\n  if (f && f.pass.value) ipcRenderer.send('login-typed', { user: (f.user && f.user.value) || 'admin', pass: f.pass.value });\n}\ndocument.addEventListener('click', (e) => {\n  const f = loginForm();\n  if (f && f.button.contains(e.target)) captureTyped();\n}, true);\ndocument.addEventListener('keydown', (e) => { if (e.key === 'Enter') captureTyped(); }, true);\n\nlet onLogin = false;\nlet attempts = 0;\nlet lastAttempt = 0;\n\nasync function tick() {\n  const f = loginForm();\n  if (!f) {\n    if (onLogin) { log('logged in'); ipcRenderer.send('login-succeeded'); }\n    onLogin = false;\n    return;\n  }\n  if (!onLogin) log('login screen shown');\n  onLogin = true;\n\n  if (Date.now() - lastAttempt < 12000) return;           // give the last attempt time to work\n  if (document.activeElement === f.pass && f.pass.value) return; // you're typing; leave it alone\n  if (attempts >= 2) {                                    // saved login no longer works (password changed?)\n    if (attempts === 2) { log('saved login did not work; waiting for you to log in'); ipcRenderer.send('login-rejected'); attempts++; }\n    return;\n  }\n  const saved = await ipcRenderer.invoke('login-get');\n  if (!saved || !saved.pass) return;                      // nothing saved yet: you log in once by hand\n  attempts++;\n  lastAttempt = Date.now();\n  log(`filling in saved login (attempt ${attempts})`);\n  if (f.user) fill(f.user, saved.user || 'admin');\n  fill(f.pass, saved.pass);\n  setTimeout(() => { const g = loginForm(); if (g) g.button.click(); }, 300);\n}\n\n// ---------- peek mode: show only the live picture, nothing else ----------\n// The Reolink page draws the stream into a <video> or <canvas>; we pick the biggest one,\n// hide everything else and stretch it over the whole panel. Toggle with\n// document.documentElement.classList.toggle('peek') (right-click menu \"Show Reolink controls\").\nconst PEEK_CSS = `\n  html.peek, html.peek body { background: #000 !important; overflow: hidden !important; }\n  html.peek body * { visibility: hidden !important; }\n  html.peek [data-peek], html.peek [data-peek] * { visibility: visible !important; }\n  html.peek [data-peek] {\n    position: fixed !important; inset: 0 !important; left: 0 !important; top: 0 !important;\n    width: 100vw !important; height: 100vh !important; max-width: none !important; max-height: none !important;\n    margin: 0 !important; transform: none !important; object-fit: contain !important;\n    background: #000 !important; z-index: 2147483647 !important;\n  }`;\nlet peekEl = null;\nfunction peek() {\n  if (!document.getElementById('mini-peek-css')) {\n    const style = document.createElement('style');\n    style.id = 'mini-peek-css';\n    style.textContent = PEEK_CSS;\n    (document.head || document.documentElement).appendChild(style);\n    document.documentElement.classList.add('peek');\n  }\n  if (loginForm()) { document.documentElement.classList.remove('peek'); return; } // never hide the login\n  if (!document.documentElement.dataset.peekOff) document.documentElement.classList.add('peek');\n  if (peekEl && peekEl.isConnected && peekEl.hasAttribute('data-peek')) return;\n  // Measure with peek styling off so we see the page's own layout.\n  const was = document.documentElement.classList.contains('peek');\n  document.documentElement.classList.remove('peek');\n  const best = [...document.querySelectorAll('video, canvas')]\n    .map((el) => ({ el, area: el.getBoundingClientRect().width * el.getBoundingClientRect().height }))\n    .filter((c) => c.area > 40000)\n    .sort((a, b) => b.area - a.area)[0];\n  if (was) document.documentElement.classList.add('peek');\n  if (!best) return;\n  document.querySelectorAll('[data-peek]').forEach((el) => el.removeAttribute('data-peek'));\n  best.el.setAttribute('data-peek', '');\n  peekEl = best.el;\n  log(`peek: showing ${best.el.tagName.toLowerCase()} only`);\n}\n\nwindow.addEventListener('DOMContentLoaded', () => setInterval(() => {\n  tick().catch(() => {});\n  try { peek(); } catch {}\n}, 1000));\n"
